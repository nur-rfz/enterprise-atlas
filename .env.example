# Required for structured synonym generation and fact extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Choose one configured public-web search adapter.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Alternative search adapter:
# SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

# Licensed read-only LinkedIn enrichment through Needle.
NEEDLE_API_KEY=
NEEDLE_CONNECTED_ACCOUNT_ID=
# classic or sales_navigator
NEEDLE_MODE=classic
